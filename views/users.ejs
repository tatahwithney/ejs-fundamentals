<%- include("partials/header") %>

<main>
    <h1>Users</h1>

    <ul>
        <% users.forEach(user => { %>
            <li>
                <strong class="user_name"><%= user.name %></strong>
                - <span class="user_email"><%= user.email %></span>
                <span class="user_age"><%= user.age %></span>
            </li>
        <% }) %>
    </ul>
</main>

<%- include("partials/footer") %>