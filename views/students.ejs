<%- include("partials/header") %>

<main>
    <h1>Students</h1>

    <a href="/students/new">Add New Student</a>

    <ul>
        <% students.forEach(student => { %>
            <li>
                <a href="/students/<%= student.id %>">
                    <%= student.name %>
                </a>
            </li>
        <% }) %>
    </ul>
</main>

<%- include("partials/footer") %>