<%- include("partials/header") %>

<h1>Students</h1>

<a href="/students/new">Add New Student</a>

<ul>
  <% students.forEach((student) => { %>
    <li>
      <a href="/students/<%= student._id %>">
        <%= student.name %>
      </a>
      - <%= student.email %>
      - <%= student.course %>
    </li>
  <% }) %>
</ul>

<%- include("partials/footer") %>